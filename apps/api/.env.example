# Copy to .env and fill in values

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase service_role key (from Project Settings → API → service_role)
# Use service_role, NOT anon — the API server needs write access
SUPABASE_KEY=eyJ...

# Random secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret

# HTTP port (default: 7891)
PORT=7891

# Path to built web app (relative to apps/api/ when running with go run)
WEB_DIST_PATH=../../apps/web/dist

# Local directory for uploaded images
IMAGE_DIR=./canvas-images

# Google OAuth client id for "Sign in with Google" (public, not a secret).
# Create at console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (type: Web). Add your origins to Authorized JavaScript
# origins (e.g. http://localhost:5173 for dev, https://tandemcanvas.com for
# prod). Leave empty to disable sign-in. The web build needs the same value
# as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Set to true in production (https) so the session cookie is marked Secure.
# Leave false/unset for local http dev or the cookie won't be stored.
COOKIE_SECURE=false

# Minutes an 'executing' task claim is honored before it counts as stuck and
# the next task_start may atomically take it over (lazy expiry — no background
# job). Default 15; set 0 to disable expiry entirely.
# CLAIM_TTL_MINUTES=15

# Outbound-webhook delivery worker (migration 0038). Enabled by default; set
# false to keep the background loop off — e.g. before 0038 has been applied, or
# on a second process that shouldn't also drain the delivery queue.
# WEBHOOKS_ENABLED=true

# LOCAL DEV ONLY. Disables the delivery worker's SSRF guard so webhooks can
# reach loopback / RFC1918 / link-local addresses — specifically, so the
# `tandem-local` container can deliver to a `tandem-mcp listen` running on the
# host at http://host.docker.internal:8787/webhook. Only the exact values "1"
# and "true" enable it; anything else leaves the guard on.
#
# NEVER SET THIS IN PRODUCTION. With it on, anyone who can edit a canvas's
# webhook config can make the server connect to your internal network,
# including the 169.254.169.254 cloud metadata endpoint.
# TANDEM_WEBHOOKS_ALLOW_PRIVATE=1

# Optional GitHub token for the READ-ONLY status proxy (TDM-45), which resolves
# the commit / PR / branch links a task completion carries into a live state for
# the board. Without it the proxy is unauthenticated and GitHub allows 60
# requests/hour per IP for the whole server; with it, 5,000. A fine-grained
# token with PUBLIC READ access only is enough — nothing here ever writes to
# GitHub. Leave empty to run unauthenticated (the 60s server-side cache is what
# makes that workable). NB: NOT named GITHUB_* — GitHub Actions reserves that
# prefix for its own built-in secret, so the deploy secret must use this name.
# GH_STATUS_TOKEN=
